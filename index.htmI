 <!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>My Nova Flow</title>

  <style>
    * {
      margin: 0;
      padding: 0;
      box-sizing: border-box;
    }

    body {
      font-family: Arial, Helvetica, sans-serif;
      background:
        radial-gradient(circle at top, rgba(126, 34, 206, 0.22), transparent 35%),
        #07070b;
      color: white;
      min-height: 100vh;
    }

    nav {
      width: 100%;
      max-width: 1200px;
      margin: auto;
      padding: 24px 28px;
      display: flex;
      justify-content: space-between;
      align-items: center;
    }

    .logo {
      font-size: 22px;
      font-weight: 800;
      letter-spacing: 1px;
    }

    .nav-button {
      text-decoration: none;
      color: white;
      border: 1px solid rgba(255,255,255,0.2);
      padding: 11px 18px;
      border-radius: 999px;
      font-size: 14px;
    }

    .hero {
      min-height: 78vh;
      display: flex;
      align-items: center;
      justify-content: center;
      text-align: center;
      padding: 70px 24px;
    }

    .hero-inner {
      max-width: 900px;
    }

    .eyebrow {
      display: inline-block;
      background: rgba(147, 51, 234, 0.14);
      border: 1px solid rgba(168, 85, 247, 0.35);
      color: #d8b4fe;
      padding: 9px 16px;
      border-radius: 999px;
      font-size: 13px;
      font-weight: 700;
      margin-bottom: 24px;
      letter-spacing: 0.6px;
    }

    h1 {
      font-size: clamp(44px, 7vw, 82px);
      line-height: 1.03;
      letter-spacing: -3px;
      margin-bottom: 25px;
    }

    .purple-text {
      background: linear-gradient(90deg, #c084fc, #8b5cf6, #a855f7);
      -webkit-background-clip: text;
      -webkit-text-fill-color: transparent;
    }

    .hero p {
      max-width: 720px;
      margin: 0 auto 34px;
      color: #b8b8c5;
      font-size: 19px;
      line-height: 1.7;
    }

    .buttons {
      display: flex;
      justify-content: center;
      gap: 14px;
      flex-wrap: wrap;
      margin-bottom: 45px;
    }

    .btn {
      text-decoration: none;
      font-weight: 700;
      padding: 15px 25px;
      border-radius: 12px;
      transition: 0.2s ease;
    }

    .btn-primary {
      color: white;
      background: linear-gradient(135deg, #7e22ce, #9333ea);
      box-shadow: 0 10px 35px rgba(147, 51, 234, 0.28);
    }

    .btn-primary:hover {
      transform: translateY(-2px);
    }

    .btn-secondary {
      color: white;
      background: rgba(255,255,255,0.04);
      border: 1px solid rgba(255,255,255,0.14);
    }

    .benefits {
      display: flex;
      justify-content: center;
      gap: 12px;
      flex-wrap: wrap;
    }

    .benefit {
      color: #d6d6df;
      background: rgba(255,255,255,0.035);
      border: 1px solid rgba(255,255,255,0.08);
      border-radius: 999px;
      padding: 10px 15px;
      font-size: 13px;
    }

    @media (max-width: 600px) {
      nav {
        padding: 20px;
      }

      h1 {
        letter-spacing: -2px;
      }

      .hero p {
        font-size: 17px;
      }

      .buttons {
        flex-direction: column;
      }

      .btn {
        width: 100%;
      }
    }
  </style>
</head>

<body>

  <nav>
    <div class="logo">MY NOVA FLOW</div>
    <a class="nav-button" href="#book">Book a Consultation</a>
  </nav>

  <main class="hero">
    <div class="hero-inner">

      <div class="eyebrow">AI-POWERED CLIENT COMMUNICATION</div>

      <h1>
        Never Let Another
        <span class="purple-text">Potential Customer</span>
        Go Unanswered.
      </h1>

      <p>
        My Nova Flow helps businesses answer calls, messages, and inquiries
        24/7 with AI—so more leads turn into booked appointments and paying customers.
      </p>

      <div class="buttons">

        <!-- Replace this link with your real demo website -->
        <a class="btn btn-primary" href="#" target="_blank">
          See the AI Receptionist Demo →
        </a>

        <!-- Replace this link with your GoHighLevel booking link -->
        <a class="btn btn-secondary" href="#" id="book">
          Book a Consultation
        </a>

      </div>

      <div class="benefits">
        <div class="benefit">✓ 24/7 Responses</div>
        <div class="benefit">✓ Instant Follow-Up</div>
        <div class="benefit">✓ More Bookings</div>
        <div class="benefit">✓ Fewer Missed Leads</div>
      </div>

    </div>
  </main>

</body>
</html>
